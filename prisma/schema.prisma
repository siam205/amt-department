  category     String
  question     String   @db.Text
  answer       String   @db.Text
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@index([category])
  @@map("faq")
}

model Visitor {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  role          String?
  affiliation   String?
  photoUrl      String
