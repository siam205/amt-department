model BusRoute {
  id             String   @id @default(cuid())
  slug           String   @unique
  routeName      String // "Technical → SU"
  busNumber      String
  contact        String
  // String[] paired arrays; admin form serializes via JSON-encoded
  // hidden input (same pattern as Phase 5 GalleryEditor).
  departureTimes String[]
  returnTimes    String[]
  displayOrder   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

