model TransportLanding {
  id            String   @id @default("singleton")
  introBody     String   @db.Text
  bannerHeading String
  bannerBody    String   @db.Text
  // instructions Json: [{iconName, title, body}] — 3 rows
  // (MapPin / Sparkles / Bus icons in current render). Reuses the
  // Phase 5 LaboratoryFacility "features" Json shape.
  instructions  Json
  updatedAt     DateTime @updatedAt

  @@map("transport_landing")
}

// ─────────────────────────────────────────────────────────────────
//  Phase 8a — Admission CMS Part 1 (Notices + Prospectus)
// ─────────────────────────────────────────────────────────────────

// Formal Registrar letterhead documents. Multi-row;
// /admission/notice renders the latest isActive=true row ordered by
// publishedAt DESC. No public archive route in Phase 8a (Decision
// B1) — admin toggles isActive to swap the visible notice.
model AdmissionNotice {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  refNo       String
  subject     String
  publishedAt DateTime
  displayDate String?

  headerOverline String @default("Office of the Registrar")

  // Json string[] of HTML-safe paragraphs (inline <strong>/<em>
  // allowed via dangerouslySetInnerHTML, author-trust caveat from
  // Phase 7 TransportLanding pattern).
  bodyParagraphs Json

  signatoryPreamble    String?
  signatoryName        String
  signatoryDesignation String

  ccLabel String @default("Copy for Kind Information (not according to seniority)")
  ccList  Json

  heroImageUrl      String?
  heroImagePublicId String?

  fileUrl      String?
  filePublicId String?
  fileName     String?

  isActive     Boolean  @default(true)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
  @@index([isActive, publishedAt])
  @@map("admission_notice")
}

// One row per program prospectus PDF. Mirrors Phase 7 Syllabus
// shape 1:1 — separate tables (Decision D) because a program may
// have both a syllabus and a prospectus, so a shared slug would
// collide. /admission/prospectus surfaces all rows with a UG/PG
// filter (client-side, same as the original hardcoded page).
model ProspectusEntry {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  shortTitle    String
  department    String
  // level — 'Undergraduate' | 'Postgraduate'. Zod-validated.
  level         String
  coverUrl      String
  coverPublicId String?
  pdfUrl        String?
  pdfPublicId   String?
  pdfFileName   String?
  displayOrder  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([displayOrder])
  @@index([level])
  @@map("prospectus_entry")
}

// ─────────────────────────────────────────────────────────────────
//  Phase 8b — Admission CMS Part 2 (Requirements + Tuition Fees)
// ─────────────────────────────────────────────────────────────────

// Singleton — university-wide admission policy. Discovery showed
// /admission/requirements has NO per-program differentiation, so
// this is deliberately NOT linked to Program. If per-program overlay
// emerges later (e.g., MSc needs GRE), add a ProgramRequirement
// child table — additive.
model AdmissionRequirements {
  id    String @id @default("singleton")
  intro String @db.Text

  undergraduateRequirements Json // string[]
  additionalNotes           Json // string[]

  diplomaRequirements  Json // string[]
  combinedGpaBody      String @db.Text // HTML-allowed (inline <strong>)
  diplomaQuickCriteria Json // [{label, value}]

  updatedAt DateTime @updatedAt

  @@map("admission_requirements")
}

// One row per Program. Json columns hold the deeply nested overview/
// shifts/policies trees. Phase 8c relaxed the original "no new
// components" reading of constraint #4 — admin form for these Json
// columns ships structured editors (OverviewStatsEditor,
// ShiftsEditor, PoliciesEditor) since no existing editor fits the
// shape (see PR #10). Zod validates shape on submit. onDelete:
// Cascade so deleting a Program tears down its fee structure
// cleanly. Future 1:N escape: drop @unique on programId, add
// intakeYear field.
model ProgramFeeStructure {
  id        String  @id @default(cuid())
  programId String  @unique
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  introOverline String // e.g., "B.Sc. in Electrical and Electronics Engineering (EEE)"
  introHeading  String @default("Tuition Fee Structure")
  introBody     String @db.Text

  // [{iconName, label, value}] — 4 cards (Total Credits, etc.)
  overviewStats Json
  // [{iconName, name, shiftLabel, description,
  //   groups: [{background, tiers: [{gpa, perCredit, total}]}]}]
  // 3-level nesting; admin paste/edit as JSON.
  shifts        Json
  // [{iconName, title, text}] — 3 policy cards
  policies      Json

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("program_fee_structure")
}

// ─────────────────────────────────────────────────────────────────
//  Phase 8c — Admission CMS Part 3 (Transfer Credits + Waiver/Scholarship)
//  Final mini-phase of the 3-part Admission CMS series. After this
//  migration, all 6 /admission/* pages are DB-driven and every
//  visible user-facing surface on the public site is admin-editable.
// ─────────────────────────────────────────────────────────────────

// Singleton — universal credit transfer policy (no per-program
// differentiation). Two stat cards (max limit + transfer fee) are
// stored as 6 flat columns rather than a Json array because the
// page architecture is structurally fixed at exactly two cards;
// flat columns are clearer admin UX than a Json the admin would
// have to extend.
model AdmissionTransferCredits {
  id    String @id @default("singleton")
  intro String @db.Text

  // {heading, body}[] — body has HTML allowed (inline <strong>)
  minimumGradeBullets Json

  limitMaxLabel    String @default("Maximum Transfer Limit")
  limitMaxValue    String
  limitMaxSubtitle String
  limitFeeLabel    String @default("Credit Transfer Fee")
  limitFeeValue    String
  limitFeeSubtitle String

  documentsIntroText String @db.Text
  documents          Json // [{title, description}]

  summaryKicker  String @default("Quick Reference")
  summaryHeading String @default("Summary of Key Constraints")
  summaryRows    Json // [{label, value}]

  updatedAt DateTime @updatedAt

  @@map("admission_transfer_credits")
}

// Singleton — chrome around the WaiverCategory + Scholarship
// multi-row content on /admission/waiver-scholarship.
model WaiverScholarshipLanding {
  id    String @id @default("singleton")
  intro String @db.Text

  part1Kicker  String @default("Part 01")
  part1Heading String @default("Tuition Fee Waivers")

  summaryHeading    String @default("Summary Table")
  summarySubheading String @default("Quick reference for all waiver categories.")
  summaryRows       Json // [{category, max, status}]
  summaryFooterNote String @db.Text

  part2Kicker  String @default("Part 02")
  part2Heading String @default("Merit Scholarships")
  part2Intro   String @db.Text

  keyTakeawaysKicker String @default("Key Takeaways")
  keyTakeaways       Json // string[]

  updatedAt DateTime @updatedAt

  @@map("waiver_scholarship_landing")
}

// Multi-row — waiver category cards on Part 01. Each row has 3-5
// inline items as {heading, text}[] Json; optional note callout
// at the bottom of the card (only "Staff & Dependent" uses it in
// seeded data). Drag-reorderable.
model WaiverCategory {
  id           String   @id @default(cuid())
  slug         String   @unique
  iconName     String // Lucide name
  title        String
  items        Json // [{heading, text}]
  note         String?  @db.Text
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("waiver_category")
}

// Multi-row — merit scholarship slab cards on Part 02. Flat
// columns (no nested Json). isHighlight=true gets the "Best Value"
// ribbon + primary-bg theme on the public card.
model Scholarship {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String // "Slab 1"
  credits      String // "10 Credits or Fewer"
  base         String // "2%" / "Highest"
  perfect      String // GPA 4.00 percentage
  near         String // GPA 3.90–3.99 percentage
  isHighlight  Boolean  @default(false)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("scholarship")
}

// ─────────────────────────────────────────────────────────────────
//  Phase 9 — Contact form backend (Path B: email + DB log)
//    First demand-driven phase post-CMS-complete. ContactSubmission
//    is the persistent audit log. Email recipient lives on the
//    UniversityIdentity singleton (contactSubmissionEmail). When
//    that field is null the submission still stores; the email
//    dispatch is gracefully skipped and emailSentAt stays null.
//    status flow: 'new' → 'read' → 'archived'. Hard-delete on
//    explicit admin action (GDPR-friendly posture for personal data).
// ─────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────
//  Phase 10 — Contact page content + Campus Locations
//    Closes out the last hardcoded-content gap from Phase 8c
//    declaration. Contact form backend was Phase 9; this is the
//    page chrome + 4 quick-contact cards + 3 campus location cards.
// ─────────────────────────────────────────────────────────────────

model ContactPageContent {
  id String @id @default("singleton")

  // Hero (PageShell)
  heroTitle                String // "Contact Us"
  heroOverline             String? // "Get in Touch"
  heroImageUrl             String
  heroImagePublicId        String?
  heroImageVerticalPercent Int     @default(50)

  // Intro paragraph (HTML allowed, single block — page only has one)
  introBody String @db.Text

  // Section headings (defaults match the original hardcoded copy)
  quickContactHeading String @default("Quick Contact Information")
  formHeading         String @default("Send Us a Message")
  formSubheading      String @db.Text // "Have a question or suggestion?..."
  campusesHeading     String @default("Campus Locations")

  // Form-side response-time hint (rendered above the submit button)
  responseTimeNote String // "We typically respond within 1-2 business days."

  // quickContactCards — Json [{ iconName, title, primaryValue,
  //   primaryHref?, secondaryValue?, secondaryHref?, hint? }]
  // 4 cards in seeded data (Phone / Email / Website / Facebook).
  // iconName resolved against a curated Lucide IconMap on the public
  // side with a sensible fallback (same pattern as Phase 7
  // TransportLanding.instructions). Editable via a Json textarea
  // in the admin form — chair Decision (Phase 10 mini): no new
  // structured editor for low-churn content.
  quickContactCards Json

  updatedAt DateTime @updatedAt

  @@map("contact_page_content")
}

// Multi-row — campus location cards on /contact. 3 rows seeded
// (Permanent / Green Road / Mohakhali). tag + phone are optional
// (Permanent Campus has neither in the seed source). Drag-reorderable.
model CampusLocation {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String // "Permanent Campus"
  tag          String? // "City Campus-1"
  address      String   @db.Text
  phone        String?
  email        String
  // Optional Google Maps URL (e.g. maps.app.goo.gl/... share link) for
  // the campus pin. Footer + contact page prefer this when present;
  // they fall back to an address-based maps.google.com/?q= search.
  mapsUrl      String?
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("campus_location")
}

// ─────────────────────────────────────────────────────────────────
//  Phase 12 — JourneyCTASection content (between content + footer)
//    Closes the last layout-level chrome gap missed by the Phase 10
//    page-only audit. Hero image + heading + body + 2 CTA buttons,
//    all DB-driven; seed mirrors the prior hardcoded values so first
//    deploy is pixel-identical (admin can edit afterward).
// ─────────────────────────────────────────────────────────────────

model JourneyCTAContent {
  id String @id @default("singleton")

  // Hero background image (Cloudinary-paired). Vertical percent is
  // 0 = top edge visible, 100 = bottom edge visible; renderer emits
  // `center {N}%` as the CSS object-position value. Phase 13
  // standardized from String to Int across all hero-bearing entities.
  heroImageUrl             String
  heroImagePublicId        String?
  heroImageVerticalPercent Int     @default(50)

  // Display copy. body is HTML-allowed (inline <strong>/<em>) under
  // the Phase 4 J1 author-trusted pattern.
  heading String
  body    String @db.Text

  // Two CTAs (MainNavItem pattern — label + href + isExternal).
  primaryCtaLabel    String
  primaryCtaHref     String
  primaryCtaExternal Boolean @default(true)

  secondaryCtaLabel    String
  secondaryCtaHref     String
  secondaryCtaExternal Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("journey_cta_content")
}

// ─────────────────────────────────────────────────────────────────
//  Phase 17 — Legal pages (Privacy Policy + Terms & Conditions)
//    Single combined singleton so both pages share one admin form +
//    one migration. Two public routes (/privacy-policy and
//    /terms-and-conditions) read this row and pick their own half.
//    body fields store HTML (inline + headings + lists allowed)
//    rendered via dangerouslySetInnerHTML with a .legal-body CSS
//    scope — Phase 4 J1 author-trust pattern, audience is the chair.
// ─────────────────────────────────────────────────────────────────

model LegalPagesContent {
  id String @id @default("singleton")

  // Privacy Policy (PageShell hero + structured sections)
  privacyHeroTitle                String  @default("Privacy Policy")
  privacyHeroOverline             String? @default("Legal")
  privacyHeroImageUrl             String
  privacyHeroImagePublicId        String?
  privacyHeroImageVerticalPercent Int     @default(50)
  // sections — Json [{ heading?: string | null, paragraphs: string[] }]
  // Each section is an optional heading + flat paragraph list. Admin
  // edits via SectionsEditor (no raw HTML markup); inline emphasis
  // characters are escaped, so the chair only writes prose.
  privacySections                 Json

  // Terms & Conditions (PageShell hero + structured sections)
  termsHeroTitle                String  @default("Terms & Conditions")
  termsHeroOverline             String? @default("Legal")
  termsHeroImageUrl             String
  termsHeroImagePublicId        String?
  termsHeroImageVerticalPercent Int     @default(50)
  termsSections                 Json

  updatedAt DateTime @updatedAt

  @@map("legal_pages_content")
}

model ContactSubmission {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String    @db.Text
  // status — 'new' | 'read' | 'archived'. Zod-validated against the
  // closed set; stored as String for forward flexibility (same
  // pattern as Phase 6 News.category).
  status      String    @default("new")
  submittedAt DateTime  @default(now())
  // ipAddress — first hop from x-forwarded-for (Vercel sets this);
  // userAgent — raw header. Both nullable: behind a misconfigured
  // proxy or curl without UA, they may be missing.
  ipAddress   String?
  userAgent   String?   @db.Text
  // emailSentAt — null = email skipped (no recipient configured)
  // OR email failed (see emailError). emailError populated only on
  // Resend SDK error; null on success or skipped-no-recipient.
  emailSentAt DateTime?
  emailError  String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, submittedAt])
  @@index([submittedAt])
  @@map("contact_submission")
}

// ─────────────────────────────────────────────────────────────────
//  Admission Lead Popup
//    Homepage-only lead-capture popup, shown once per browser session
//    after a configurable delay. AdmissionLeadPopup is the singleton
//    content/behaviour config; AdmissionLead is the leads inbox
//    populated by the public submit — same shape as ContactSubmission
//    (flat fields, string status, ip/UA audit trail, email dispatch
//    metadata) so the admin patterns are copy-identical.
// ─────────────────────────────────────────────────────────────────

model AdmissionLeadPopup {
  id             String  @id @default("singleton")
  enabled        Boolean @default(true)
  delaySeconds   Int     @default(15)
  heading        String  @default("Start your journey with Sonargaon University")
  subheading     String  @default("Get personalized admission guidance from our admission team.")
  buttonText     String  @default("Get admission guidance")
  successMessage String  @default("Our admission team will contact you shortly.")

  updatedAt DateTime @updatedAt

  @@map("admission_lead_popup")
}

model AdmissionLead {
  id            String @id @default(cuid())
  fullName      String
  mobileNumber  String
  // Denormalized programme name (not a Program relation) — same
  // reasoning as every other "what did the visitor pick at that
  // moment" field on this site: a lead should keep saying what the
  // visitor actually chose even if the programme is later renamed
  // or removed.
  programmeName String
  // status — 'new' | 'contacted' | 'archived'. Zod-validated against
  // the closed set; stored as String, same pattern as
  // ContactSubmission.status.
  status        String    @default("new")
  submittedAt   DateTime  @default(now())
  ipAddress     String?
  userAgent     String?   @db.Text
  emailSentAt   DateTime?
  emailError    String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, submittedAt])
  @@index([submittedAt])
  @@map("admission_lead")
}

// ─────────────────────────────────────────────────────────────────
//  Newsletter page + subscribers
//    Singleton CMS for the public /newsletter landing (hero, intro,
//    advantages list, form labels) + a subscribers table populated
//    by the public form submit. Subscribers are stored DB-only —
//    chair queries / exports via /admin/newsletter-subscribers.
// ─────────────────────────────────────────────────────────────────

model NewsletterPage {
  id                       String   @id @default("singleton")
  // Hero (PageShell)
  heroTitle                String
  heroSubtitle             String?
  heroOverline             String?
  heroImageUrl             String
  heroImagePublicId        String?
  heroImageVerticalPercent Int      @default(50)
  // Intro paragraph above the advantages grid (HTML allowed,
  // sanitized at render time — same J1 pattern as AboutOverview).
  introBody                String   @db.Text
  // Advantages section
  advantagesOverline       String?
  advantagesHeading        String
  // advantages — Json [{ iconName, title, description }]. iconName
  // resolves through DynamicLucideIcon (Phase 20). Variable length;
  // admin manages via a structured editor.
  advantages               Json
  // Subscribe form
  ctaHeading               String
  ctaBody                  String?
  ctaButtonLabel           String // "Subscribe"
  emailPlaceholder         String // "you@example.com"
  // Optional note under the form (e.g. privacy reassurance).
  privacyNote              String?
  updatedAt                DateTime @updatedAt

  @@map("newsletter_page")
}

// Generic per-page hero CMS. Each public page that doesn't already
// own a singleton with hero fields (AboutOverview, AboutDepartmentClub,
// LegalPage, NewsLanding, ContactPageContent, NewsletterPage, etc.)
// gets a row keyed by `pageKey` — that way the chair can change the
// hero image + copy independently per page without N singleton
// tables. Admin reads/writes via /admin/page-heroes.
model PageHero {
  id                       String   @id @default(cuid())
  pageKey                  String   @unique
  // Human-readable label shown to admin (e.g. "Faculty Members List").
  pageLabel                String
  // Public route this hero powers, so the admin edit form can link
  // out to "View page" (e.g. "/faculty-member", "/admission/notice").
  publicPath               String
  heroTitle                String
  heroSubtitle             String?
  heroOverline             String?
  heroImageUrl             String
  heroImagePublicId        String?
  heroImageVerticalPercent Int      @default(50)
  updatedAt                DateTime @updatedAt

  @@map("page_hero")
}

// SUEEC join applications — populated by the public popup form
// on /about/eee-club. Admin reviews + approves/rejects via
// /admin/eee-club-applications.
model DepartmentClubApplication {
  id          String   @id @default(cuid())
  fullName    String
  studentId   String // SU ID (e.g. SU1603141114)
  email       String
  phone       String
  semester    String // '1'..'8' (stored String for forward flex)
  motivation  String   @db.Text
  // status — 'pending' | 'approved' | 'rejected'. Zod-validated;
  // String for forward flexibility (same as ContactSubmission.status).
  status      String   @default("pending")
  // Forensics — same shape as ContactSubmission / NewsletterSubscriber.
  ipAddress   String?
  userAgent   String?  @db.Text
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, submittedAt])
  @@index([submittedAt])
  @@map("department_club_application")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  // status — 'active' | 'unsubscribed'. Future unsubscribe flow can
  // flip this without losing history. Stored as String (forward-
  // flexible, same as ContactSubmission.status).
  status    String   @default("active")
  // Where the submission came from. Currently only 'newsletter-page';
  // future footer-form or popup signups can tag themselves separately.
  source    String?
  // Forensics — first hop from x-forwarded-for / raw UA header.
  // Same nullable shape as ContactSubmission so the same redaction
  // helpers apply.
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("newsletter_subscriber")
}

/// Course structure and credit distribution for a program, shown on the
/// program page and offered as a PDF at the bottom of it.
///
/// Semesters and rows are Json rather than two more tables: nothing queries
/// an individual course, the whole curriculum is read and rendered in one go,
/// and a department revising its curriculum replaces the lot. The shapes are
/// asserted where they are read (coerceSemesters / coerceCreditRows).
model ProgramCurriculum {
  id        String  @id @default(cuid())
  programId String  @unique
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  /// [{ name, courses: [{ code, title, type, credits, remarks, prerequisite }] }]
  semesters  Json
  /// [{ semester, total, core, elective, lab, project, cumulative }]
  creditRows Json

  /// The same content as a downloadable PDF. Null until one is uploaded.
  pdfUrl      String?
  pdfPublicId String?
  pdfFileName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("program_curriculum")
}

/// Where each office sits in the building — the "department layout" the
/// university actually supplies, which is a directory rather than a floor plan.
///
/// Separate from DepartmentLayout: that model holds documents (a cover and a
/// PDF), and a person looking for the Registrar wants a row they can read, not
/// a file to download.
model OfficeLocation {
  id           String  @id @default(cuid())
  name         String
  /// "Level: 05" as written, or "Ground Floor" — the wording varies and is the
  /// department's own.
  level        String
  building     String
  /// Set for the offices belonging to this department, so they can be shown first.
  isDepartment Boolean @default(false)
  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@map("office_location")
}

/// One row of the department's service charter: what a student wants done, the
/// steps to do it, and who is responsible.
///
/// The steps are Json because the source table gives up to three of them and a
/// service may use one or all three; the person is stored as written, since the
/// spreadsheet packs a name, title, phone, email and room number into one cell
/// and splitting that into columns would invent structure the department does
/// not keep.
model ServiceCharterEntry {
  id           String @id @default(cuid())
  serial       Int
  title        String @db.Text
  /// string[] — the process flow, in order.
  steps        Json
  responsible  String @db.Text
  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@map("service_charter_entry")
}
