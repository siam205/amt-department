  // No DateTime parse; publicationYear below is the optional
  // structured sort key.
  date            String?
  publicationYear Int?
  links           Json     @default("[]")
  displayOrder    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

